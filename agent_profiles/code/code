#!/usr/bin/env bash
set -euo pipefail

profile=/pi_agent/agent_profiles/code

if [ ! -d "$profile/opencode" ]; then
  printf 'code profile is unavailable: %s\n' "$profile" >&2
  exit 1
fi

# Keep profile-owned agents, settings, and plugins in the config directory.
# Load MCP defaults separately so project config can override MCP enablement.
export OPENCODE_CONFIG_DIR="$profile/opencode"
export OPENCODE_CONFIG="$profile/opencode/mcp-defaults.jsonc"
unset OPENCODE_CONFIG_CONTENT
unset OPENCODE_TUI_CONFIG OPENCODE_DISABLE_PROJECT_CONFIG

# OMO Slim's background scheduler and web search are profile-only settings.
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true
export OPENCODE_ENABLE_EXA=1

is_tui=true
case "${1-}" in
  acp|agent|attach|completion|db|export|github|import|mcp|models|plugin|pr|providers|run|serve|session|stats|uninstall|upgrade|web)
    is_tui=false
    ;;
esac

if [ "$is_tui" = true ]; then
  port=
  port_arg_pending=false
  for arg in "$@"; do
    if [ "$port_arg_pending" = true ]; then
      port=$arg
      port_arg_pending=false
      continue
    fi
    case "$arg" in
      --port)
        port_arg_pending=true
        ;;
      --port=*)
        port=${arg#--port=}
        ;;
    esac
  done

  if [ -z "$port" ]; then
    if [ -n "${OPENCODE_PORT:-}" ]; then
      port=$OPENCODE_PORT
    else
      port=$(python3 - <<'PY'
import random
import socket

for _ in range(100):
    candidate = random.randint(49152, 65535)
    with socket.socket() as sock:
        try:
            sock.bind(("127.0.0.1", candidate))
        except OSError:
            continue
        print(candidate)
        break
else:
    raise SystemExit("unable to find a free OpenCode port")
PY
)
    fi
    export OPENCODE_PORT=$port
    set -- --port "$port" "$@"
  else
    export OPENCODE_PORT=$port
  fi
fi

exec opencode "$@"
