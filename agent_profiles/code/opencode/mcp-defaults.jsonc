{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tavily": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.tavily.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      }
    },
    "deepwiki": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.deepwiki.com/mcp"
    },
    // Disabled by default; explicitly enable only when opting in to the
    // LangChain expert's dedicated MCPs.
    "docs-langchain": {
      "type": "remote",
      "enabled": false,
      "url": "https://docs.langchain.com/mcp"
    },
    "reference-langchain": {
      "type": "remote",
      "enabled": false,
      "url": "https://reference.langchain.com/mcp"
    },
    "langsmith": {
      "type": "remote",
      "url": "https://eu.api.smith.langchain.com/mcp",
      "enabled": false,
      "oauth": false,
      "headers": {
        "X-Api-Key": "{env:LANGSMITH_API_KEY}"
      }
    }
  }
}
