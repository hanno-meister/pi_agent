{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tavily": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.tavily.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      }
    },
    "deepwiki": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.deepwiki.com/mcp"
    },
    // Enabled at the server level so @langchain-expert (and @librarian) can use
    // them; per-agent `mcps` lists keep them off every other agent.
    "docs-langchain": {
      "type": "remote",
      "enabled": true,
      "url": "https://docs.langchain.com/mcp"
    },
    "reference-langchain": {
      "type": "remote",
      "enabled": true,
      "url": "https://reference.langchain.com/mcp"
    },
    "langsmith": {
      "type": "remote",
      "url": "https://api.smith.langchain.com/mcp",
      "enabled": true,
      "headers": { "X-Api-Key": "{env:LANGSMITH_API_KEY}" }
    }
  }
}
