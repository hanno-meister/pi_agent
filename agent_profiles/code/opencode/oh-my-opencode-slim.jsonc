        ]
      }
    }
  },
  "agents": {
    "langchain-expert": {
      "description": "LangChain / LangGraph / LangSmith / Deep Agents specialist",
      "skills": [
        "deep-agents-core",
        "deep-agents-memory",
        "deep-agents-orchestration",
        "deepagents-python-quickstart",
        "deepagents-typescript-quickstart",
        "ecosystem-primer",
        "eval-engineering",
        "langchain-dependencies",
        "langchain-fundamentals",
        "langchain-middleware",
        "langchain-python-quickstart",
        "langchain-rag",
        "langchain-typescript-quickstart",
        "langgraph-cli",
        "langgraph-fundamentals",
        "langgraph-human-in-the-loop",
        "langgraph-persistence",
        "langgraph-python-quickstart",
        "langgraph-typescript-quickstart",
        "langsmith-dataset",
        "langsmith-evaluator",
        "langsmith-online-eval-engineering",
        "langsmith-trace",
        "managed-deep-agents",
        "skill-creator",
        "swarm"
      ],
      "mcps": [
        "docs-langchain",
        "reference-langchain",
        "langsmith"
      ],
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "task": "deny"
      },
      "orchestratorPrompt": "@langchain-expert\n- Role: Read-only LangChain / LangGraph / LangSmith / Deep Agents diagnostic specialist, separate from @librarian. Use only local read, grep, glob, list, and lsp plus the docs-langchain, reference-langchain, and langsmith MCPs. No web browsing/webfetch, edits, shell, implementation, mutation, or delegation.\n- **Routing boundary:** generic/current-library research → @librarian; broad repository navigation → @explorer; ordinary implementation → parent/@fixer; UI → @designer. Hand back when scope or information is unavailable.\n- **Pass in the isolated handoff:** task, repo root, relevant paths, verbatim errors, observed vs desired behavior, LangSmith IDs, previous attempts, and package/runtime versions.\n- Before recommending validation, inspect scripts, CI, tests, manifests, and lockfiles read-only; give exact parent-run commands and expected signals, and never claim execution.\n- Return these headings in order: Status and scope; Findings or root cause; Likely affected paths; Exact proposed changes (only if warranted); Evidence and confidence; Applicable versions; Validation handoff; Blockers and remaining risks. Use Confirmed/Likely/Unverified, label unavailable evidence/inputs, and state findings without forcing a root cause."
    }
  }
}
