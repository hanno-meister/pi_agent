{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@3.0.1/oh-my-opencode-slim.schema.json",
  "preset": "openai",
  "autoUpdate": false,
  "disabled_agents": [
    "observer",
    "langchain-expert"
  ],
  "multiplexer": {
    "type": "tmux",
    "layout": "main-vertical",
    "main_pane_size": 60
