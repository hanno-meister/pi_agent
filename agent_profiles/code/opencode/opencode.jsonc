{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "oh-my-opencode-slim@2.2.17"
  ],

  "default_agent": "orchestrator",
  "lsp": true,

  // Keep the profile on the Compose-injected .env credential. This takes
  // precedence over an older provider credential persisted by OpenCode.
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  },

  "mcp": {
    "langsmith": {
      "type": "remote",
      "url": "https://eu.api.smith.langchain.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "X-Api-Key": "{env:LANGSMITH_API_KEY}"
      }
    }
  },

  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
