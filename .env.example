# Optional provider credentials. Leave values empty when the provider is unused.
# Every entry in .env is passed to the pi container, so new credentials work
# without editing compose.yaml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
# LangSmith tracing, datasets, and evals for the code profile's langchain-expert.
LANGSMITH_API_KEY=

# Optional Git author identity used for commits made in the container.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
