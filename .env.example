# Optional provider credentials. Leave values empty when the provider is unused.
# Every entry in .env is passed to the pi container, so new credentials work
# without editing compose.yaml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
# LangSmith tracing, datasets, and evals for the code profile's langchain-expert.
LANGSMITH_API_KEY=

# Voice dictation defaults. The model can be changed per Pi session with
# /voice-setup; language and maximum recording duration remain reproducible
# environment defaults.
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_LANGUAGE=en
VOICE_MAX_DURATION_SECONDS=120
VOICE_GATEWAY_PORT=4317

# Optional Git author identity used for commits made in the container.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
